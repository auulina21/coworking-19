classDiagram
direction TB
class CoworkingMember {
  <<abstract>>
  -String id
  -String name
  #CoworkingMember(id, name)
  +getId() String
  +getName() String
  +role() String
}
class TariffPlan {
  <<interface>>
  +tariff() String
}
class Resident {
  -String currentTariff
  -String nextTariff
  +Resident(id, name)
  +role() String
  +tariff() String
  +book(booking, interval) String
  +book(booking, space, start, end) String
  +changeTariff(next) String
}
class SpaceManager {
  -String layout
  +SpaceManager(id, name)
  +role() String
  +tariff() String
  +manageLayout(layout) String
}
class Accountant {
  +Accountant(id, name)
  +role() String
  +tariff() String
  +invoice(booking) String
}
class TimeInterval {
  -String id
  -String resident
  -String space
  -String start
  -String end
  +TimeInterval(id, resident, space, start, end)
  +id() String
  +resident() String
  +space() String
  +start() String
  +end() String
}
class BookingState {
  <<enumeration>>
  DRAFT
  CONFIRMED
  CANCELLED
}
class Booking {
  -AccessControl access
  +setAccessControl(access) void
  -String id
  -BookingState state
  -List~TimeInterval~ intervals
  +Booking(id)
  +add(interval) String
  +getIntervals() List~TimeInterval~
  +getState() BookingState
  +getId() String
  +confirm() String
  +cancel() String
  +hours() double
}
class AccessControl {
  <<interface>>
  +grant(bookingId) String
}
class ConsoleAccessControl {
  +ConsoleAccessControl()
  +grant(bookingId) String
}
CoworkingMember <|-- Resident
CoworkingMember <|-- SpaceManager
CoworkingMember <|-- Accountant
Resident ..|> TariffPlan
SpaceManager ..|> TariffPlan
Accountant ..|> TariffPlan
Booking "1" *-- "0..*" TimeInterval : володіє
Booking --> BookingState
Booking --> AccessControl : setter DI
ConsoleAccessControl ..|> AccessControl
Resident ..> Booking : book
Resident ..> TimeInterval
Accountant ..> Booking : invoice

note for CoworkingMember "getId() є final; role() є abstract"

note for Resident "BASIC або FLEX; changeTariff змінює лише nextTariff наступного місяця"
note for Booking "Поля обов’язкові; id незмінний і унікальний; ISO local datetime до хвилини; start < end; [start,end) без перетинів для одного місця"

note for Resident "Автоматичний id інтервалу — UUID, незалежний від місця й часу"

note for Booking "getIntervals() повертає незмінну копію List.copyOf; зовнішній клієнт не змінює внутрішню колекцію"
