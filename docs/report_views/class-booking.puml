@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam nodesep 30
skinparam ranksep 35
skinparam wrapWidth 200
left to right direction
class TimeInterval {
  -String id
  -String resident
  -String space
  -String start
  -String end
  +TimeInterval(id, resident, space, start, end)
  +id() String
  +resident() String
  +space() String
  +start() String
  +end() String
}
class BookingState {
  <<enumeration>>
  DRAFT
  CONFIRMED
  CANCELLED
}
class Booking {
  -AccessControl access
  +setAccessControl(access) void
  -String id
  -BookingState state
  -List<TimeInterval> intervals
  -final TimeIntervalStorage storage
  +Booking(storage)
  +add(interval) String
  +getIntervals() List<TimeInterval>
  +getState() BookingState
  +getId() String
  +confirm() String
  +cancel() String
  +hours() double
}
class AccessControl {
  <<interface>>
  +grant(bookingId) String
}
class ConsoleAccessControl {
  +ConsoleAccessControl()
  +grant(bookingId) String
}
class TimeIntervalStorage {
  +inTransaction(work) Object
  <<interface>>
  +save(interval) void
  +findAll() List<TimeInterval>
}
Booking "1" *-- "0..*" TimeInterval : володіє
Booking --> BookingState
Booking --> AccessControl : setter DI
ConsoleAccessControl ..|> AccessControl
Booking --> TimeIntervalStorage : constructor Inject
TimeIntervalStorage ..> TimeInterval
note bottom of Booking : getIntervals(): незмінна копія; setter DI для AccessControl
@enduml